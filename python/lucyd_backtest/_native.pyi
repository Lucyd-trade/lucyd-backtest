from types import SimpleNamespace
from typing import Optional, Union

Outcome = Union[int, str]

class LucydError(Exception): ...

class Book:
    ts_ms: int
    def best_bid(self, outcome: Outcome) -> Optional[SimpleNamespace]: ...
    def best_ask(self, outcome: Outcome) -> Optional[SimpleNamespace]: ...
    def mid(self, outcome: Outcome) -> Optional[float]: ...
    def bids(self, outcome: Outcome) -> list[tuple[float, float]]: ...
    def asks(self, outcome: Outcome) -> list[tuple[float, float]]: ...

class Ctx:
    now_ms: int
    usdc: float
    usdc_total: float
    def markets(self) -> list[SimpleNamespace]: ...
    def open_markets(self) -> list[SimpleNamespace]: ...
    def market(self, market: str) -> Optional[SimpleNamespace]: ...
    def book(self, market: str) -> Optional[Book]: ...
    def best_bid(self, market: str, outcome: Outcome) -> Optional[SimpleNamespace]: ...
    def best_ask(self, market: str, outcome: Outcome) -> Optional[SimpleNamespace]: ...
    def price(self, feed: str) -> Optional[SimpleNamespace]: ...
    def market_price(self, market: str) -> Optional[SimpleNamespace]: ...
    def position(self, market: str, outcome: Outcome) -> float: ...
    def open_orders(self, market: Optional[str] = None) -> list[SimpleNamespace]: ...
    def limit(self, market: str, outcome: Outcome, side: str, price: float, tokens: float) -> int: ...
    def market_order(
        self, market: str, outcome: Outcome, side: str, tokens: float, limit: Optional[float] = None
    ) -> int: ...
    def cancel(self, order_id: int) -> None: ...
